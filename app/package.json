{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"test:hmr": "playwright test --config playwright.hmr.config.ts",
		"db:generate": "tsx scripts/db/generate-types.ts",
		"db:check": "tsx scripts/db/check-types.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25",
		"@types/better-sqlite3": "^7.6.13",
		"@vitest/browser": "^3.2.4",
		"@xmldom/xmldom": "^0.9.10",
		"daisyui": "^5.5.8",
		"better-sqlite3": "^12.5.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.5.0",
		"kysely-codegen": "^0.19.0",
		"mdsvex": "^0.12.7",
		"phosphor-svelte": "^3.1.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"serve": "^14.2.4",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"typescript-eslint": "^8.59.1",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@journeyapps/wa-sqlite": "^1.2.1",
		"@triiiceratops/plugin-annotation-editor": "1.0.0-rc.6",
		"@triiiceratops/plugin-sdk": "1.0.0-rc.5",
		"@floating-ui/dom": "^1.7.6",
		"@tiptap/core": "^3.22.5",
		"@tiptap/extension-bubble-menu": "^3.22.5",
		"@tiptap/extension-document": "^3.22.5",
		"@tiptap/extension-floating-menu": "^3.22.5",
		"@tiptap/extension-history": "^3.22.5",
		"@tiptap/extension-text": "^3.22.5",
		"@tiptap/extensions": "^3.22.5",
		"@tiptap/pm": "^3.22.5",
		"collatex-tsport": "file:../collatex/collatex-tsport",
		"events": "^3.3.0",
		"kysely": "^0.28.8",
		"lucide-svelte": "^1.0.1",
		"nanoid": "^5.1.11",
		"sqlite-wasm-kysely": "^0.3.0",
		"triiiceratops": "1.0.0-rc.31"
	}
}
